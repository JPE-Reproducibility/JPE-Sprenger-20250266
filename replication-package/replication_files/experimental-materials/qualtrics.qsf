nary);\n\tconsole.log(\"midbinary:\"+middleoutcome_binary);\n\tconsole.log(\"highbinary:\"+highoutcome_binary);\n\n\t\t\t\t\t\t\t\t\t\n\t\t\tvar current=numbers.indexOf(questionnumber);\n\t\n\t\t\tconsole.log(\"current: \"+current);\n\t\t\tconsole.log(\"currentdecision binary: \"+currentdecision_binary);\n\t\t\tconsole.log(\"questionnumber: \"+questionnumber);\n\t\t\tconsole.log(\"numbers: \" + numbers);\n\t\t\tconsole.log(\"p: \" + p);\n\t\n\t\t\tvar p_current=p[current]*100;\n\t\t\tvar r_current=r[current]*100;\n\t\t\tvar type_current=type[current];\n\t\t\tvar low_current=lowoutcome_binary[current];\n\t\t\tvar middle_current=middleoutcome_binary[current];\n\t\t\tvar high_current=highoutcome_binary[current];\n\t\n\t\t\tconsole.log(\"low:\"+low_current);\n\t\t\tconsole.log(\"mid:\"+middle_current);\n\t\t\tconsole.log(\"high:\"+high_current);\n\t\n\t\/*\n\tMath.floor(Math.random() * (max - min + 1) + min)\n\t*\/\n\t\n\t\t\tif(current<10){\n\t\t\t\tvar prefix = \"binary\"+type_current+\"_\"+p_current;\n\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"_row\", middle_current);\n\t\t\t} else if(current>=10){\n\t\t\t\tvar prefix = \"binary\"+type_current+\"high_\"+p_current;\n\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"_row\", high_current);\n\t\t\t}\n\t\n\t\t\tdocument.getElementById(\"prefix\").innerHTML = prefix; \n\t\t\n\t\t\tif(type_current==\"AC\"){\n\t\t\t\tvar left_1=p_current;\n\t\t\t\tvar left_3=100-p_current;\n\t\t\t\tvar right_2=100;\n\t\t\t} else if(type_current==\"DE\"){\n\t\t\t\tvar left_1=(r_current*p_current)\/100;\n\t\t\t\tvar left_3=100-(r_current*p_current)\/100;\n\t\t\t\tvar right_2=r_current;\n\t\t\t\tvar right_3=(100-r_current);\n\t\t\t} \n\t\t\t\n\t\t\n\t\t\t\n\t\t\t\t\n\tconsole.log(\"questionprefix: \"+prefix);\n\t\n\tvar side=Math.random();\n\tif(side<=0.5){\n\t\tvar binaryside=1;\n\t} else{\n\t\tvar binaryside=2;\n\t}\n\t\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"_order\", currentdecision);\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"currentdecision\", currentdecision+1);\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"currentdecision_binary\", currentdecision_binary+1);\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"_side\", binaryside);\n\n\t\n\tif(binaryside==1){\t\n\t\tif(type_current==\"AC\"){\n\t\t\tvar leftpos1=left_3 + \"% chance of $\"+low_current;\n\t\t\tvar leftpos2=left_1 + \"% chance of $\"+high_current;\n\t\t\tvar leftpos3= \"\";\n\t\t\tvar rightpos1=right_2 + \"% chance of $\"+middle_current;\n\t\t\tvar rightpos2=\"\";\n\t\t\tvar rightpos3=\"\";\n\t\t\tdocument.getElementById(\"leftpos1\").innerHTML = leftpos1; \n\t\t\tdocument.getElementById(\"leftpos2\").innerHTML = leftpos2; \n\t\t\tdocument.getElementById(\"leftpos3\").innerHTML = leftpos3;\n\t\t\tdocument.getElementById(\"rightpos1\").innerHTML = rightpos1; \n\t\t\tdocument.getElementById(\"rightpos2\").innerHTML = rightpos2; \n\t\t\tdocument.getElementById(\"rightpos3\").innerHTML = rightpos3; \n\t\t}\n\t\tif(type_current==\"DE\"){\n\t\t\tvar leftpos1=left_3 + \"% chance of $\"+low_current;\n\t\t\tvar leftpos2=left_1 + \"% chance of $\"+high_current;\n\t\t\tvar leftpos3=\"\";\n\t\t\tvar rightpos1=right_3 + \"% chance of $\"+low_current;\n\t\t\tvar rightpos2=right_2 + \"% chance of $\"+middle_current;\n\t\t\tvar rightpos3=\"\";\n\t\t\tdocument.getElementById(\"leftpos1\").innerHTML = leftpos1; \n\t\t\tdocument.getElementById(\"leftpos2\").innerHTML = leftpos2; \n\t\t\tdocument.getElementById(\"leftpos3\").innerHTML = leftpos3;\n\t\t\tdocument.getElementById(\"rightpos1\").innerHTML = rightpos1; \n\t\t\tdocument.getElementById(\"rightpos2\").innerHTML = rightpos2; \n\t\t\tdocument.getElementById(\"rightpos3\").innerHTML = rightpos3; \n\t\t}\n\t}\n\t\n\t\n\tif(binaryside==2){\t\n\t\tif(type_current==\"AC\"){\n\t\t\tvar rightpos1=left_3 + \"% chance of $\"+low_current;\n\t\t\tvar rightpos2=left_1 + \"% chance of $\"+high_current;\n\t\t\tvar rightpos3= \"\";\n\t\t\tvar leftpos1=right_2 + \"% chance of $\"+middle_current;\n\t\t\tvar leftpos2=\"\";\n\t\t\tvar leftpos3=\"\";\n\t\t\tdocument.getElementById(\"leftpos1\").innerHTML = leftpos1; \n\t\t\tdocument.getElementById(\"leftpos2\").innerHTML = leftpos2; \n\t\t\tdocument.getElementById(\"leftpos3\").innerHTML = leftpos3;\n\t\t\tdocument.getElementById(\"rightpos1\").innerHTML = rightpos1; \n\t\t\tdocument.getElementById(\"rightpos2\").innerHTML = rightpos2; \n\t\t\tdocument.getElementById(\"rightpos3\").innerHTML = rightpos3; \n\t\t}\n\t\tif(type_current==\"DE\"){\n\t\t\tvar rightpos1=left_3 + \"% chance of $\"+low_current;\n\t\t\tvar rightpos2=left_1 + \"% chance of $\"+high_current;\n\t\t\tvar rightpos3=\"\";\n\t\t\tvar leftpos1=right_3 + \"% chance of $\"+low_current;\n\t\t\tvar leftpos2=right_2 + \"% chance of $\"+middle_current;\n\t\t\tvar leftpos3=\"\";\n\t\t\tdocument.getElementById(\"leftpos1\").innerHTML = leftpos1; \n\t\t\tdocument.getElementById(\"leftpos2\").innerHTML = leftpos2; \n\t\t\tdocument.getElementById(\"leftpos3\").innerHTML = leftpos3;\n\t\t\tdocument.getElementById(\"rightpos1\").innerHTML = rightpos1; \n\t\t\tdocument.getElementById(\"rightpos2\").innerHTML = rightpos2; \n\t\t\tdocument.getElementById(\"rightpos3\").innerHTML = rightpos3; \n\t\t}\n\t}\n\n\n\n\/*\n\t\tif(type_current==\"AC\"){\n\t\t\tvar leftpos1=left_3 + \"% chance of $\"+lowoutcome_binary;\n\t\t\tvar leftpos2=left_1 + \"% chance of $\"+highoutcome_binary;\n\t\t\tvar rightpos1=right_2 + \"% chance of $\"+middleoutcome_binary;\n\t\t\tdocument.getElementById(\"leftpos1\").innerHTML = leftpos1; \n\t\t\tdocument.getElementById(\"leftpos2\").innerHTML = leftpos2; \n\t\t\tdocument.getElementById(\"leftpos3\").style.display = 'none';\n\t\t\tdocument.getElementById(\"rightpos1\").innerHTML = rightpos1; \n\t\t\tdocument.getElementById(\"rightpos2\").style.display = 'none';\n\t\t\tdocument.getElementById(\"rightpos3\").style.display = 'none';\n\t\t}\n\t\tif(type_current==\"DE\"){\n\t\t\tvar leftpos1=left_3 + \"% chance of $\"