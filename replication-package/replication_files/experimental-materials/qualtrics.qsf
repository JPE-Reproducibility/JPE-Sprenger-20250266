tvar left_middle=100;\n\t\t\t\tvar left_high=0;\n\t\t\t\tvar right_high=(r_paid*p_paid)\/100;\n\t\t\t\tvar right_middle=100-r_paid;\n\t\t\t\tvar right_low=(r_paid*(100-p_paid))\/100;\n\t\t\t} else if(type_paid==\"DE\"){\n\t\t\t\tvar left_high=0;\n\t\t\t\tvar left_middle=r_paid;\n\t\t\t\tvar left_low=100-r_paid;\n\t\t\t\tvar right_high=(r_paid*p_paid)\/100;\n\t\t\t\tvar right_middle=0;\n\t\t\t\tvar right_low=100-(r_paid*p_paid)\/100;\n\t\t\t} \n\n\tvar randomprob= Math.floor(Math.random() * (100 - 0 + 1) + 0);\n\t\n\tvar choicepaid=eval(\"choice\"+randqbinary);\n\t\n\tconsole.log(\"choicepaid: \", choicepaid);\n \nif(type_paid==\"AC\"){\n\tif(choicepaid==4){\n  var BINbonus=middleoutcome_paid;\n  } else if(choicepaid==5 && randomprob <= left_high){\n  var BINbonus=highoutcome_paid;\n  } else if(choicepaid==5 && randomprob > left_high){\n  var BINbonus=lowoutcome_paid;\n  }\n} \nif(type_paid==\"AB\"){\n\tif(choicepaid==4){\n  var BINbonus=middleoutcome_paid;\n  } else if(choicepaid==5 && randomprob > left_high){\n  var BINbonus=highoutcome_paid;\n  } else if(choicepaid==5 && randomprob <= left_low + left_middle && randomprob>left_low){\n  var BINbonus=middleoutcome_paid;\n  }else if(choicepaid==5 && randomprob <= left_low){\n  var BINbonus=lowoutcome_paid;\n  }\n} \n\nif(type_paid==\"DE\"){\n\tif(choicepaid==4 && randomprob <= left_high){\n  var BINbonus=highoutcome_paid;\n  } else if(choicepaid==4 && randomprob > left_high){\n  var BINbonus=lowoutcome_paid;\n  } else if (choicepaid ==5 && randomprob <= right_middle){\n  var BINbonus=middleoutcome_paid;\n  }  else if (choicepaid ==5 && randomprob > right_middle){\n  var BINbonus=lowoutcome_paid;\n  }\n} \t\n\n\t\n\t\nconsole.log(\"BIN:\"+BINbonus);\n\t\n\t\nvar randombonus= 9;\t\t\nvar BINbonus = (typeof BINbonus === 'undefined') ? randombonus : BINbonus;\n\t\n\t\n\t\n\tQualtrics.SurveyEngine.setEmbeddedData(\"BINbonus\", BINbonus);\n\t\n\t\/*\n\tvar types = [\"choice\"];\n\tvar typesLength = types.length;\n\tvar prob