hoiceAnswerValue();\n\n    console.log(\"choice: \"+choicecaptured);\n\t\n\t\n\tQualtrics.SurveyEngine.setEmbeddedData(\"choice\"+currentdecision, choicecaptured);\n});","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"\u00a0 Decision ${e:\/\/Field\/currentdecision_binary} of ${e:\/\/Field\/numdecisions_binary}: Please choose...","Choices":{"4":{"Display":"Option A"},"5":{"Display":"Option B"}},"ChoiceOrder":["4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"<title><\/title>\n<style type=\"text\/css\">html, body { font-family: arial, sans-serif; }\n    table {}\n    table tr td {\n      text-align: center;\n      padding: 5px;\n    }\n    table th{\n      font-weight: bold;\n      border-bottom: 1px solid black;\n      text-align: center;\n    }\n    tr.noBorder td {\n      border-style: hidden;\n   }\n   .center {\n  margin-left: auto;\n  margin-right: auto;\n}\n<\/style>\n<script src=\"2A-html-string.js\"><\/script>\n<div id=\"container\">&nbsp;<\/div>\n\nDecision ${e:\/\/Field\/currentdecision} of ${e:\/\/Field\/numdecisions}: Please choose your preferred option.<br> <br><br><br>\n\n\n<table class=\"center\"; style=\"border:1px black solid\">\n <tbody>\n  <tr>\n   <th>Option A<\/th>\n   <th> <\/th>\n   <th>Option B<\/th>\n  <\/tr>\n  <tr class=\"noBorder\">\n   <td id=\"leftpos1\">&nbsp;<\/td>\n   <td> <\/td>\n   <td id=\"rightpos1\">&nbsp;<\/td>\n  <\/tr>\n  <tr class=\"noBorder\">\n   <td id=\"leftpos2\">&nbsp;<\/td>\n   <td> <\/td>\n   <td id=\"rightpos2\">&nbsp;<\/td>\n  <\/tr>\n  <tr class=\"noBorder\">\n   <td id=\"leftpos3\">&nbsp;<\/td>\n   <td> <\/td>\n   <td id=\"rightpos3\">&nbsp;<\/td>\n  <\/tr>\n <\/tbody>\n<\/table>","DataExportTag":"Q1343","QuestionID":"QID1343"}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID1344","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q388","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":28,"NextAnswerId":1,"QuestionID":"QID1344"}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID1345","SecondaryAttribute":"Decision ${e:\/\/Field\/currentdecision} of ${e:\/\/Field\/numdecisions_mpl}: Please complete the decis...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Decision ${e:\/\/Field\/currentdecision} of ${e:\/\/Field\/numdecisions_mpl}: Please complete the decision problem below.<br \/>\n<br \/>\n<span style=\"color:#bdc3c7;\">Reminder: Please indicate which option you prefer on each row by clicking on the row where you would like to switch from choosing the option on the left to choosing the option on the right.<\/span><\/span><\/span><\/div>\n\n<div>&nbsp;<\/div>\n\n<div>\n<div><span style=\"color:#bdc3c7;\"><span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">(Note that you cannot click on the submit button until you have selected an answer.<span style=\"font-weight: bolder;\">&nbsp;<\/span>In order to progress, your choices must &quot;switch&quot; from Option A to Option B, like shown below. You will have to click once on Option A and once on Option B, in the subsequent row, to proceed. You can also click Option A in all rows, or Option B in all rows.)<\/span><\/span><\/span><\/div>\n<\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n\t\t{\n\t\t\t\/*Place your JavaScript here to run when the page loads*\/\n\n\n\t\t\/\/ disable submit button\n\t\tthis.hideNextButton();\n\n\t\t\/\/\t this.disableNextButton();\n\n\t\t\tvar loop = parseInt(\"${lm:\/\/CurrentLoopNumber}\");\n\t\t\t\/\/$j(\".QuestionText\").remove();\n\t\t\tvar inputId = \"#\" + String(this.questionId);\n\n\t\t\/\/ Using Piped Text to get embedded data fields\n\t\n\t\t\tvar currentdecision=parseInt(\"${e:\/\/Field\/currentdecision}\");\n\t\t\tvar questionnumber=currentdecision.toString();\n\t\n\t\t\tvar p=\"${e:\/\/Field\/p}\".split(',');\n\t\t\tvar r=\"${e:\/\/Field\/r}\".split(',');\n\t\t\tvar type=\"${e:\/\/Field\/type}\".split(', ');\n\t\t\tvar numbers=\"${e:\/\/Field\/numbers}\".split(',');\n\t\t\tvar order=\"${e:\/\/Field\/order}\".split(',');\n\t\n\t\t\tvar increment=1;\n\t\n\t\n\t\t\tconsole.log(p);\n\t\t\tconsole.log(r);\n\t\t\tconsole.log(type);\n\t\t\tconsole.log(numbers);\n\t\t\tconsole.log(order);\n\t\t\tconsole.log(currentdecision);\n\t\t\tconsole.log(questionnumber);\n\t\n\t\n\t\t\t\n\t\t\t\t\t\t\n\t\t\tvar current=order.indexOf(questionnumber);\n\t\n\t\t\tconsole.log(current);\n\t\n\t\t\tvar p_current=p[current]*100;\n\t\t\tvar r_current=r[current]*100;\n\t\t\tvar type_current=type[current];\n\t\n\t\t\t\n\t\n\t\t\tconsole.log(\"p: \"+p_current);\n\t\t\tconsole.log(\"r: \"+r_current);\n\t\t\tconsole.log(\"type: \"+type_current);\n\t\n\t\n\t\t\t\n\t\n\t\t\t\n\t\t\tif(type_current==\"AC\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=p_current;\n\t\t\t\tvar right_low=100-p_current;\n\t\t\t} else if(type_current==\"ACrepeat\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=p_current;\n\t\t\t\tvar right_low=100-p_current;\n\t\t\t} else if(type_current==\"AB\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_middle=100-r_current;\n\t\t\t\tvar right_low=(r_current*(100-p_current))\/100;\n\t\t\t} else if(type_current==\"ABrepeat\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_middle=100-r_current;\n\t\t\t\tvar right_low=(r_current*(100-p_current))\/100;\n\t\t\t} else if(type_current==\"DE\"){\n\t\t\t\tvar left_middle=r_current;\n\t\t\t\tvar left_low=100-r_current;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_low=100-(r_current*p_current)\/100;\n\t\t\t} else if(type_current==\"DErepeat\"){\n\t\t\t\tvar left_middle=r_current;\n\t\t\t\tvar left_low=100-r_current;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_low=100-(r_current*p_current)\/100;\n\t\t\t} \n\t\t\t\n\t\n\t\n\t\t\t\n\t\n\t\tvar lowoutcome=parseInt(\"${e:\/\/Field\/lowoutcome}\");\n\t\tvar middleoutcome=(p_current\/100)*30;\n\t\tvar stake=middleoutcome+50;\n\t\n\t\t\t\n\t\t\tvar optionAunits = \" tasks\";\n\t\t\tvar optionBunits = \" tasks\";\n\t\t\tvar optionAtext = \"100% chance of \";\n\t\t\tvar optionAvalue = \"$\";\n\t\t\tvar percentchanceof = \"% chance of \";\n\t\t\tvar comma = \",\";\n\t\t\tvar dollar = \"$\";\n\t\t\tvar dollarbold=dollar.bold();\n\t\t\t\n\t\t\t\n\t\t\tvar prefix=\"choice\";\n\t\t\t\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"pval\"+currentdecision, p[current]);\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"rval\"+currentdecision, r[current]);\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"type\"+currentdecision, type_current);\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"currentdecision\", currentdecision+1);\n\t\t\t\n\t\t\/\/ ============================================================================\n\t\t\/\/ TABLE COLUMN HEADERS \n\t\t\t$j(inputId).append(\"<table  align='center' class='uncertainty'>\\\n\t\t<thead class='uncertaintyhead'>\\\n\t\t<tr>\\\n\t\t<th style='width:12em' class='thtext'> Option A:  <\/th>\\\n\t\t\t<th style='width:1em'><\/th>\\\n\t\t<th style='width:12em' class='thtext'> Option B:  <\/th>\\\n\t\t<\/tr>\\\n\t\t<\/thead>\\\n\t\t<tbody class='uncert' id='maintable'>\\\n\t\t<tr class='middletd'>\\\n\t\t\t<td><\/td>\\\n\t\t\t<td><\/td>\\\n\t\t\t<td><\/td>\\\n\t\t<\/tr>\\\n\t\t<\/tbody>\\\n\t\t<\/table>\")\n\t\t\/\/ ============================================================================\n\t\t\/\/ TABLE ROWS \n\t\tmultistring = \"\";\n\t\tincrement = 1;\n\tfor (i = middleoutcome; i <= middleoutcome+50; i++) {\n\t\t\tvar num = i*increment;\n\t\t\tvar n = num.toFixed(0);\n\t\t\tvar nbold=n.bold();\n\t\t\t\/\/multistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ optionAtext + \" \" + dollar + p_current + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ p2 + optionBtext + \" \" + dollarbold + nbold + comma + \"<\/br>\" +  p1 + optionBtext + \" \" + dollar + x3  +\"<\/td><\/tr>\";}\t\t\/\/ SAVE OUTPUT \n\t\t\n\t\n\t\tif(type_current==\"AC\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} else if(type_current==\"ACrepeat\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} else if(type_current==\"AB\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_middle + percentchanceof + dollar + middleoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} else if(type_current==\"ABrepeat\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_middle + percentchanceof + dollar + middleoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} else if(type_current==\"DE\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_low + percentchanceof+ dollar + lowoutcome + \"<\/br>\" + left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} else if(type_current==\"DErepeat\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_low + percentchanceof+ dollar + lowoutcome + \"<\/br>\" + left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} \n\t\t}\n\t\t\t\t\t \n\t\t\t\n\t\t\t\n\t\t$j('#maintable').append(multistring)\n\t\t\t\t\t\n\t\t\n\n\t\t\tvar choiceThatCounts = -1;\n\t\t\/\/save the data\n\t\t\tvar time_start = Date.now() \/ 1000;\n\t\t\tvar times = [];\n\t\t\tvar choices = [];\n\t\t\tvar changed=[];\n\t\t\/\/ Up the list count\n\t\t\tvar list = \"${e:\/\/Field\/list}\"\n\t\t\tvar list =\tparseInt(list);\n\t\t\tvar list = list + 1;\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"list\", list);\n\t\t\t\n\t\t\/\/ set var = -1 \n\t\tvar choice_now = -1 ; \n\t\tvar choice_complete = -1;\n\n\t\t$j('.letters').click(function() {\n\t\t\tid = $j(this).attr('name');\n\t\t\tvar time = Date.now() \/ 1000 - time_start;      \n\t\t\tchoice_now = $j(this).attr('id');\n\t\t\ttimes.push(time.toFixed(2));\n\t\t\tchoices.push(choice_now);\n\t\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"Time\", times);\n\t\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"Choices\", choices);\n\t\t\t\n\t\t\tvar id_number = parseInt(id, 10);\n\t\t\tconsole.log(id_number);\n\t\t\t$j(\"td[name='\"+id+\"']\").removeClass(\"letters_selected\").addClass(\"letters\");\n\t\t\t$j(this ).removeClass(\"letters\").addClass(\"letters_selected\");\t\n\t\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+currentdecision+\"IdFinal\", id_number);\n\t\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+currentdecision+\"ChoiceFinal\", choice_now);\n\t\t\tif (choice_now.indexOf(\"left\") >= 0) { \n\t\t\t\t\t\tvar norm_lb = (id_number-1)*increment;\n\t\t\t\t\t\tvar norm_ub = (id_number)*increment;\n\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\tfor (k = id_number ; k > middleoutcome; k--) {\n                        x = \"#\" + String(k) + \"left\";\n                        y = \"#\" + String(k) + \"right\";\n                        \/\/ set this checked property to true so we can test for it in completeness check\n                        $j(x).prop(\"checked\", true);\n                        $j( x ).removeClass(\"letters\").addClass(\"letters_selected\");\n                        $j( y ).addClass(\"letters\").removeClass(\"letters_selected\");\n                    }\n\t\t\t\t\t} else {\t\n\t\t\t\t\t\tvar norm_lb = (id_number-2)*increment; \n\t\t\t\t\t\tvar norm_ub = (id_number-1)*increment; \n\t\t\t\t\t\t\n\t\t\t\t\t\tfor (k = id_number ; k < middleoutcome+52; k++) {\n\t\t\t\t\tx = \"#\" + String(k) + \"right\";\n\t\t\t\t\ty = \"#\" + String(k) + \"left\";\n\t\t\t\t\t\/\/ set this checked property to true so we can test for it in completeness check\n\t\t\t\t\t$j(x).prop(\"checked\", true);\n\t\t\t\t\t$j( x ).removeClass(\"letters\").addClass(\"letters_selected\");\n\t\t\t\t\t$j( y ).addClass(\"letters\").removeClass(\"letters_selected\");\n\t\t\t\t}\n\t\t\t\t\t};   \n\t\t\tif (choice_now==\"21left\") { \n\t\t\t\tvar norm_lb = stake;\n\t\t\t\tvar norm_ub = stake;\n\t\t\t\tvar changed_now =1; \n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tif (choice_now==\"1right\") { \n\t\t\t\tvar norm_lb = 0;\n\t\t\t\tvar norm_ub = 0;\n\t\t\t\tvar changed_now =2; \n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tif (norm_lb < increment) { \n\t\t\t\tvar norm_lb = 0;\n\t\t\t\tvar changed_now =3 ;\n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tif (norm_lb > stake) { \n\t\t\t\tvar norm_lb = stake;\n\t\t\t\tvar changed_now =4 ;\n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tif (norm_ub < increment) { \n\t\t\t\tvar norm_ub = 0;\n\t\t\t\tvar changed_now =5 ;\n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tif (norm_ub > stake) { \n\t\t\t\tvar norm_ub = stake;\n\t\t\t\tvar changed_now =6 ;\n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"LB\", norm_lb);\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"UB\", norm_ub);\t\t\t\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"Changed\", changed);\t\t\t\n\t\t\tvar num_rows = 0 ;\n            var checked_rows = 0 ;\n\n            for (k = middleoutcome+1 ; k < middleoutcome+52; k++) {\n\t\t\tnum_rows = num_rows + 1;\n\n                \tx = \"#\" + String(k) + \"right\";\n                \ty = \"#\" + String(k) + \"left\";\n\n\t\t\t\/\/ determine if either the cell on the left or the one on the right is checked; if so, add to the counter\n                \tif ( $j(x).prop(\"checked\") == true || $j( y ).prop(\"checked\") == true) {\n                    \t\tchecked_rows = checked_rows + 1 ;\n                \t}\n                \n\t\t}\n\n\t    \/\/ check if the number of checked rows equals the number of rows\n\t    if (checked_rows == num_rows) {\n\t\t\t    choice_complete = 1 ;\n            }\n            else {\n                choice_complete = -1;\n            }\n\n\t\t});\n\n\t\t$j('table.uncertainty').floatThead({\n\t\t\tuseAbsolutePositioning: false\n\t\t\t\/\/ absolutePositioning is better for\n\t\t\t\/\/ highly dynamic sites\n\t\t\t\/\/ (which this is not)\n\t\t});\n\t\t\t\n\n\t\t\t\/\/ enable submit button when variable no longer -1 \n\t\tthis.questionclick = function(event,element)\n\t\t\t{ \t\t \n\t\t\tif (choice_complete != -1 ) {this.showNextButton();}\n\t\telse   { \tthis.hideNextButton(); }\n\t\t\t}\n\n\t\t\t\/\/ enable submit button when variable no longer -1 \n\t\t\t\/\/this.questionclick = function(event,element)\n\t\t\t\/\/    { \t\t \n\t\t\t\/\/\t if (choice_now != -1 ) {this.enableNextButton(); }\n\t\t\t\/\/  else   { this.disableNextButton();  }\n\t\t\t\t\/\/}\n\t\t\tconsole.log(prefix+currentdecision+\"IdFinal\");\n\t\t\t\t\t \n\t\t\t\n\t\t});","DefaultChoices":false,"DataExportTag":"Q389","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Decision ${e:\/\/Field\/currentdecision} of ${e:\/\/Field\/numdecisions_mpl}: Please complete the decis...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionID":"QID1345"}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID1346","SecondaryAttribute":"Please click to proceed.","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Please click to proceed.<\/span><\/span>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\n\t\/*var currentdecision = parseInt(\"${e:\/\/Field\/currentdecision}\");\n\tvar nextdecision=currentdecision+1;\n\t\n\t\n\tQualtrics.SurveyEngine.setEmbeddedData(\"currentdecision\", nextdecision);\n\tQualtrics.SurveyEngine.setEmbeddedData(\"group1_ac_order\", currentdecision);\n*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"Q390","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please click to proceed.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID1346","DisplayLogic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"skipinstructions","Operator":"NotEqualTo","RightOperand":"1","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span>  <span class=\"LeftOpDesc\">skipinstructions<\/span> <span class=\"OpDesc\">Is Not Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID1347","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q391","QuestionID":"QID1347","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Validation":"None","GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID1348","SecondaryAttribute":"this is loop 2","TertiaryAttribute":null,"Payload":{"QuestionText":"this is loop 2","DefaultChoices":false,"DataExportTag":"Q392","QuestionID":"QID1348","QuestionType":"TE","Selector":"SL","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"this is loop 2","DisplayLogic":{"0":{"0":{"LogicType":"LoopAndMerge","LeftOperand":"BL_5jvkJ0iatw3d1JQ,2","RightOperand":"lm:\/\/CurrentLoop","Operator":"EqualTo","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\"><\/span> <span class=\"LeftOpDesc\">Loop 2: <\/span> <span class=\"OpDesc\"><\/span> <span class=\"RightOpDesc\">Current Loop<\/span>"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID1349","SecondaryAttribute":"this is loop 4","TertiaryAttribute":null,"Payload":{"QuestionText":"this is loop 4","DefaultChoices":false,"DataExportTag":"Q393","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"this is loop 4","DisplayLogic":{"0":{"0":{"LogicType":"LoopAndMerge","LeftOperand":"BL_5jvkJ0iatw3d1JQ,4","RightOperand":"lm:\/\/CurrentLoop","Operator":"EqualTo","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\"><\/span> <span class=\"LeftOpDesc\">Loop 4: <\/span> <span class=\"OpDesc\"><\/span> <span class=\"RightOpDesc\">Current Loop<\/span>"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID1349"}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID600","SecondaryAttribute":"The computer will draw a random number 1-5, with each number equally likely. If it draws a \"1,\" y...","TertiaryAttribute":null,"Payload":{"QuestionText":"<font face=\"Arial, Helvetica, sans-serif\"><span style=\"font-size: 19px;\">The computer will draw a random number 1-5, with each number equally likely. If it draws a \"1,\" you can earn an additional bonus payment based on one of your decisions (though the payment could be $0). If it draws 2-5, you will not receive an additional payment.<br>\n<br>\nClick the button to generate your random number.<\/span><\/font>","DefaultChoices":false,"DataExportTag":"Q77","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The computer will draw a random number 1-5, with each number equally likely. If it draws a \"1,\" y...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID600","DataVisibility":{"Private":false,"Hidden":false},"QuestionJS":false}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID642","SecondaryAttribute":"This is a consent form for research participation.\u00a0It contains important information about this s..","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">This is a consent form for research participation.<b>&nbsp;<\/b>It contains important information about this study and what to expect if you decide to participate.<br>\n<br>\nYour participation is voluntary.<b> <\/b>Please consider the information carefully. If you decide to participate, please feel free to save or print a copy of this form.<br>\n<br>\n<b>Description<\/b>: The experiment you are participating in today is part of a research study on decision making. The research study is designed to analyze individual behavior and preferences over risk. You will be asked to read several pages of instructions. Then you will be asked to make several choices that will determine the precise amount you will be paid.<br>\n<br>\n<span style=\"font-style:italic\"><b><span style=\"font-style:normal\">Risks and Benefits:<\/span><\/b><span style=\"font-style:normal\">&nbsp; The risks involved in this study are not substantially different from participating in normal online activities. We cannot and do not guarantee or promise that you will receive any benefits from this study. Your participation may benefit society by improving our understanding of behavior. Your decision whether or not to participate in this study will not affect your relationship with Caltech.<\/span><\/span><br>\n<br>\n<b>Duration: <\/b>Your participation in this experiment will take approximately as long as is indicated in the advertisement.<br>\n<br>\n<b>Payments: <\/b>You will receive a fixed $5 completion payment for finishing the survey. One out of five subjects will be selected to receive additional payment based on their responses and pure chance. The average total payment for participation is $15 per hour, including the completion payment. All subjects will be paid. The minimum payment is the $5 completion payment.<br>\n<br>\n<b>Subjects\u2019 Rights: <\/b>Your participation is voluntary and you have the right to&nbsp;discontinue participation at any time without penalty or loss of benefits to which you are&nbsp;otherwise entitled. The alternative is not to participate. You have the right to refuse to answer particular questions. The results of this research study may be presented at scientific or professional meetings or published in scientific journals. Your individual privacy will be maintained in all published and written data resulting from the study.<br>\n<br>\n<b>For Subjects Located In the European Economic Area:&nbsp;<\/b>If you are in the European Economic Area (European Union, Iceland, Liechtenstein, and Norway) while you participate in the research study:<br>\n<br>\nYou have the right to request access, rectification or erasure of your personal information. You also have the right to object or restrict our processing of your personal information. Finally, you have the right to data portability, e.g., a copy of the data with your personal information. In order to make any such requests, please contact Tye Welch at <a href=\"mailto:gdpr@caltech.edu\" style=\"color:blue; text-decoration:underline\">gdpr@caltech.edu<\/a>.<br>\n<br>\nIf you withdraw your consent to participate in this study, this will not affect the lawfulness of our collection, use and disclosure of your personal information, up to the point in time that you withdraw your consent. Even if you withdraw your consent, we may still use your data that has been anonymized or pseudonymized so that the data does not identify you, as permitted by applicable law for the purposes of: (a) the public interest, (b) scientific research, and (c) archiving in the public interest. Further, we will maintain your data in fully identifiable form if required by law.<br>\n<br>\nYou consent to the collection, use and disclosure of your personal information, which may include health and other sensitive personal information, for the purpose of carrying out the research study and confirming the accuracy of the study, with the lawful basis to comply with legal and regulatory requirements. You may withdraw your consent at any time, and we will stop processing (e.g., analyzing) your personal information, except as described above.<br>\n<br>\nPlease view Caltech\u2019s General Data Protection Regulation Notice at the following website: <a href=\"https:\/\/www.caltech.edu\/general-data-protection-regulation-notice\" style=\"color:blue; text-decoration:underline\">https:\/\/www.caltech.edu\/general-data-protection-regulation-notice<\/a><\/span><\/span><br>\n&nbsp;\n<h1><span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><strong>Contacts and Questions:&nbsp;<\/strong><\/span>For questions, concerns, or complaints about the study you may contact the Protocol Director, Dr. Kirby Nielsen (e-mail\u2013<a href=\"mailto:%20kirby@caltech.edu\" style=\"font-family: Arial, Helvetica, sans-serif; font-size: 19px; color: blue;\"> kirby@caltech.edu<\/a><span style=\"font-family: Arial, Helvetica, sans-serif;\">, Phone - (626) 395-4094) in the Division of Humanities and Social Sciences.<\/span><\/span><\/h1>\n<br>\n<span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Independent Contact: If you are not satisfied with how this study is being conducted, or if you have any concerns, complaints, or general questions about the research or your rights as a participant, please contact the Caltech Institutional Review Board (IRB) to speak to someone independent of the research team at (626) 395-4699 or via email at irb@caltech.edu.<\/span><br>\n<br>\n<br>\n<b id=\"docs-internal-guid-fb6fb278-7fff-d1f9-76e7-ed976baa4810\">Note: All payments in this study are listed in US Dollars ($). If you are using a different local currency, it will be converted by Prolific from US Dollars to your currency at the current exchange rate.<\/b><\/span><br>\n<br>\n&nbsp;","DefaultChoices":false,"DataExportTag":"Q119","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"This is a consent form for research participation.\u00a0It contains important information about this s...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID642","DataVisibility":{"Private":false,"Hidden":false},"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID643","SecondaryAttribute":"In this study, you will have the opportunity to earn a $${e:\/\/Field\/showupfee} completion payment...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"line-height:107%\"><span style=\"line-height:107%\">In this study, you will have the opportunity to earn a <span style=\"background:white\">$${e:\/\/Field\/showupfee} completion payment and may earn an additional bonus payment.&nbsp;<\/span><\/span><\/span><br>\n<br>\n<span style=\"line-height:107%\"><span style=\"background:white\"><span style=\"line-height:107%\">If you complete the study and enter your completion code into Prolific, you will earn the <\/span><\/span><span style=\"line-height:107%\"><span style=\"background:white\">$${e:\/\/Field\/showupfee} completion payment. In addition to this completion payment, w<\/span><\/span><span style=\"background:white\"><span style=\"line-height:107%\">e will randomly select <strong>one out of every five participants<\/strong> to receive a bonus payment.&nbsp;<\/span><\/span><\/span><\/span><\/span><br>\n&nbsp;","DefaultChoices":false,"DataExportTag":"Q120","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In this study, you will have the opportunity to earn a $${e:\/\/Field\/showupfee} completion payment...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID643","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID644","SecondaryAttribute":"In this study, you will face 42 choice tasks followed by 2 quiz tasks. At the end of the study, i...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">In this study, you will face 42 choice tasks followed by 2 quiz tasks. At the end of the study, if you are randomly selected to receive a bonus payment, then we will randomly select one of the 44 tasks, and we will determine your bonus payment based on your responses in this one randomly selected task.<\/span><\/span><br \/>\n<br \/>\n<br \/>\n<br \/>\n<br \/>\n<span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"line-height:107%\"><span style=\"background:white\"><span style=\"line-height:107%\"><strong>Note: Each of the decisions you make today may determine your bonus payment. Therefore, it is in your best interest to answer every decision carefully and in a way that reflects what you&#39;d truly prefer.<\/strong><\/span><\/span><\/span><\/span><\/span>","DefaultChoices":false,"DataExportTag":"Q121","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In this study, you will face 42 choice tasks followed by 2 quiz tasks. At the end of the study, i...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID644","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID645","SecondaryAttribute":"Each choice task will involve one or several decisions between a lottery called Option A and a lo...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Each choice task will involve one or several decisions between a lottery called Option A and a lottery called Option B. For each decision, all you have to do is decide whether you prefer Option A or Option B.<br>\n<br>\nYour decisions in the first ${e:\/\/Field\/numdecisions_mpl} choice tasks will be presented in a table in which each row represents a separate decision. In the example below, the decision in row 1 involves the choice between Option A (a 50% chance of receiving $0, 50% chance of receiving $30) and Option B (a 100% chance of <strong>$0<\/strong>). The decision in row 2 involves a choice between the same Option A, but now Option B gives a 100% chance of receiving&nbsp;<b>$1<\/b>. In row 3, Option B gives a 100% chance of&nbsp;<strong>$2<\/strong>, and so on.<\/span><\/span><br>\n<br>\n<span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">There will be one number changing in Option B in each row. In each successive row, the changing number will be larger than in the previous row. We will put the changing numbers in&nbsp;<strong>bold<\/strong>&nbsp;to help you see what changes. As you can see in the example below, the payment in Option B increases by $1 in each row.<br>\n<br>\nOption A will stay the same in each row of a given choice task.<\/span><\/span>\n<div>&nbsp;\n<div style=\"text-align: center;\"><br>\n<span style=\"font-size:16px;\"><span style=\"font-family:Georgia,serif;\">&nbsp;<\/span><\/span> <img style=\"width: 1369px; height: 1265px;\" src=\"https:\/\/emotioncaltech.co1.qualtrics.com\/CP\/Graphic.php?IM=IM_3kifBjAhCgrnAmG\"><\/div>\n\n<div style=\"text-align: left;\"><br>\n<br>\n&nbsp;<\/div>\n<\/div>","DefaultChoices":false,"DataExportTag":"Q122","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Each choice task will involve one or several decisions between a lottery called Option A and a lo...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID645","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID646","SecondaryAttribute":"To give you an example of how these choice tasks work, consider the hypothetical task below. Opti...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"line-height:107%\"><span style=\"line-height:107%\">To give you an example of how these choice tasks work, consider the hypothetical task below. Option A gives a 100% chance of $10.50. Option B gives a 100% chance of a payment that varies from $0 (in the first row) to $15 (in the last row).<\/span><\/span><br \/>\n<br \/>\n<span style=\"line-height:107%\"><span style=\"line-height:107%\">In this hypothetical decision, if you prefer more money to less, you should prefer Option A for the first 11 rows. Starting from row 12 (100% chance of $11), you should prefer Option B.<br \/>\n<br \/>\nTo avoid having to make a selection in each row, you need only click two times: once for Option A and once for Option B. Once you click on Option A in a particular row, all rows above that row will populate to indicate that you choose Option A. Once you click a row in Option B, all rows below that row will populate to indicate that you choose Option B.<br \/>\n<br \/>\nIn the example below, you would click &quot;100% chance of $10.50&quot; in Option A in the 11th row (instead of &quot;100% chance of $10&quot;), and you would click &quot;100% chance of $11&quot; in Option B in the 12th row.<br \/>\n<br \/>\n<strong>IMPORTANT: In order to progress, you have to make a selection for every row.&nbsp;<\/strong><\/span><\/span><\/span><\/span>\n<div>&nbsp;\n<div>&nbsp;\n<div style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:Georgia,serif;\">&nbsp; &nbsp;<\/span><\/span> <img src=\"https:\/\/emotioncaltech.co1.qualtrics.com\/CP\/Graphic.php?IM=IM_8lgTI08pePC7loq\" style=\"width: 675px; height: 690px;\" \/><\/div>\n<br \/>\n&nbsp;<\/div>\n\n<div><br \/>\n&nbsp;<\/div>\n<\/div>","DefaultChoices":false,"DataExportTag":"Q123","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"To give you an example of how these choice tasks work, consider the hypothetical task below. Opti...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID646","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID647","SecondaryAttribute":"Consider another example. In the example below, Option A gives $10 for sure and Option B gives a...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"line-height:107%\"><span style=\"line-height:107%\">Consider another example. In the example below, Option A gives $10 for sure and Option B gives a 50-50 chance of $10 or a varying payment that goes from $0 to $14. Suppose you prefer Option A when the varying amount is less than $10, and you prefer Option B when the varying amount is greater than $10. You would click the &ldquo;50% chance of $10, 50% chance of $11&rdquo; box, and the rows would auto-populate in orange to indicate your selection, as shown below.<\/span><br \/>\n<br \/>\n<b><span style=\"line-height:107%\">Note that you can still change your selection once the table has been auto-populated. To do so, simply click the new row in which you would want to start choosing Option B. <\/span><\/b><span style=\"line-height:107%\">Once you have made your final decision, you will be able to proceed to your next choice.<\/span><\/span><\/span><\/span>\n<div>&nbsp;<\/div>\n\n<div>&nbsp;\n<div style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:Georgia,serif;\">&nbsp;&nbsp;<\/span><\/span> <img src=\"https:\/\/emotioncaltech.co1.qualtrics.com\/CP\/Graphic.php?IM=IM_0OJRpUV5MOyf7RI\" style=\"width: 598px; height: 793px;\" \/><\/div>\n\n<div style=\"text-align: left;\">&nbsp;<\/div>\n\n<div style=\"text-align: left;\"><br \/>\n&nbsp;<\/div>\n<\/div>","DefaultChoices":false,"DataExportTag":"Q124","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Consider another example. In the example below, Option A gives $10 for sure and Option B gives a...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID647","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID648","SecondaryAttribute":"To make sure you are comfortable with how the choice tables work, please complete the following p...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"line-height:107%\"><span style=\"line-height:107%\">To make sure you are comfortable with how the choice tables work, please complete the following <b>practice choice<\/b>. Please try out how to select Option A in all rows, how to select Option B in all rows, and how to change your answer after selecting.<br \/>\n<br \/>\nAs in the main decisions, you will not be able to click to the next page until you have made a valid selection.&nbsp;To make a valid selection, you have to make a selection for every row. That is, your choices must either &quot;switch&quot; from Option A to Option B (clicking once on a row in Option A and once on the subsequent row in Option B to proceed), or you can click Option A in all rows, or Option B in all rows.<br \/>\n<br \/>\n<strong>If the page is not letting you proceed, you have not made a valid selection. Please make sure you click on Option A in the last row where you would want to select Option A, and then click on Option B in the first row you would want to select Option B (the subsequent row after selecting Option A).<\/strong><\/span><\/span><\/span><\/span>","DefaultChoices":false,"DataExportTag":"Q125","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"To make sure you are comfortable with how the choice tables work, please complete the following p...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID648","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n\t\t{\n\t\t\t\/*Place your JavaScript here to run when the page loads*\/\n\n\n\t\t\/\/ disable submit button\n\t\tthis.hideNextButton();\n\n\t\t\/\/\t this.disableNextButton();\n\n\t\t\tvar loop = parseInt(\"${lm:\/\/CurrentLoopNumber}\");\n\t\t\t\/\/$j(\".QuestionText\").remove();\n\t\t\tvar inputId = \"#\" + String(this.questionId);\n\n\t\t\/\/ Using Piped Text to get embedded data fields\n\t\n\t\t\tvar currentdecision=parseInt(\"${e:\/\/Field\/currentdecision}\");\n\t\t\tvar questionnumber=currentdecision.toString();\n\t\n\t\t\tvar p=\"${e:\/\/Field\/p}\".split(', ');\n\t\t\tvar r=\"${e:\/\/Field\/r}\".split(', ');\n\t\t\tvar type=\"${e:\/\/Field\/type}\".split(', ');\n\t\t\tvar numbers=\"${e:\/\/Field\/numbers}\".split(',');\n\t\n\t\n\t\t\tconsole.log(p);\n\t\t\tconsole.log(r);\n\t\t\tconsole.log(type);\n\t\t\tconsole.log(numbers);\n\t\n\t\n\t\t\t\n\t\t\t\t\t\t\n\t\t\tvar current=numbers.indexOf(questionnumber);\n\t\n\t\t\tconsole.log(current);\n\t\n\t\t\tvar p_current=p[current]*100;\n\t\t\tvar r_current=r[current]*100;\n\t\t\tvar type_current=type[current];\n\t\n\t\t\tconsole.log(p_current);\n\t\t\tconsole.log(r_current);\n\t\t\tconsole.log(type_current);\n\t\n\t\t\tvar left_1=50;\n\t\t\tvar left_3=50;\n\t\t\tvar right_2=100;\n\t\n\t\t\t\n\t\t\t\n\t\tconsole.log(\"left_1=\"+left_1);\n\t\tconsole.log(\"right_2=\"+right_2);\n\t\n\t\tvar lowoutcome=0;\n\t\tvar middleoutcome=parseInt(\"${e:\/\/Field\/middleoutcome}\");\n\t\tvar highoutcome=30;\n\t\n\t\t\tvar stake = parseInt(\"${e:\/\/Field\/partnertasks}\");\n\t\t\tvar optionB = parseInt(\"${e:\/\/Field\/partnertasks}\");\n\t\t\tvar x1 = parseInt(\"${e:\/\/Field\/group1_x1}\");\n\t\t\tvar x2 = parseInt(\"${e:\/\/Field\/group1_x2}\");\n\t\t\tvar x3 = parseInt(\"${e:\/\/Field\/group1_x3}\");\n\t\t\tvar p1 = parseInt(\"${e:\/\/Field\/group1_p}\");\n\t\t\tvar p2=100-p1;\n\t\t\tvar r = parseInt(\"${e:\/\/Field\/group1_r}\");\n\t\t\tvar rp=(r*p1)\/100;\n\t\t\tvar r1=100-r;\n\t\t\tvar rp1=(r*(100-p1))\/100;\n\t\t\tvar optionAunits = \" tasks\";\n\t\t\tvar optionBunits = \" tasks\";\n\t\t\tvar optionAtext = \"100% chance of \";\n\t\t\tvar optionAvalue = \"$\";\n\t\t\tvar percentchanceof = \"% chance of \";\n\t\t\tvar comma = \",\";\n\t\t\tvar dollar = \"$\";\n\t\t\tvar dollarbold=dollar.bold();\n\n\t\t\tvar prefix=\"xnorm0\";\n\n\t\t\/\/ ============================================================================\n\t\t\/\/ TABLE COLUMN HEADERS \n\t\t\t$j(inputId).append(\"<table  align='center' class='uncertainty'>\\\n\t\t<thead class='uncertaintyhead'>\\\n\t\t<tr>\\\n\t\t<th style='width:12em' class='thtext'> Option A:  <\/th>\\\n\t\t\t<th style='width:1em'><\/th>\\\n\t\t<th style='width:12em' class='thtext'> Option B:  <\/th>\\\n\t\t<\/tr>\\\n\t\t<\/thead>\\\n\t\t<tbody class='uncert' id='maintable'>\\\n\t\t<tr class='middletd'>\\\n\t\t\t<td><\/td>\\\n\t\t\t<td><\/td>\\\n\t\t\t<td><\/td>\\\n\t\t<\/tr>\\\n\t\t<\/tbody>\\\n\t\t<\/table>\")\n\t\t\/\/ ============================================================================\n\t\t\/\/ TABLE ROWS \n\t\tmultistring = \"\";\n\t\tincrement = 1;\n\t\tfor (i = 0; i <= 30; i++) {\n\t\t\tvar num = i*increment;\n\t\t\tvar n = num.toFixed(0);\n\t\t\tvar nbold=n.bold();\n\t\t\t\/\/multistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ optionAtext + \" \" + dollar + p_current + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ p2 + optionBtext + \" \" + dollarbold + nbold + comma + \"<\/br>\" +  p1 + optionBtext + \" \" + dollar + x3  +\"<\/td><\/tr>\";}\t\t\/\/ SAVE OUTPUT \n\t\t\n\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_1 + percentchanceof + dollar + lowoutcome + comma + \"<\/br>\" + left_3 + percentchanceof + dollar + highoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_2 + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";}\n\n\t\n\t\t\t\t\t\t\t\t \n\t\t\t\n\t\t\t\n\t\t$j('#maintable').append(multistring)\n\t\t\t\t\t\n\t\t\n\n\t\t\tvar choiceThatCounts = -1;\n\t\t\/\/save the data\n\t\t\tvar time_start = Date.now() \/ 1000;\n\t\t\tvar times = [];\n\t\t\tvar choices = [];\n\t\t\tvar changed=[];\n\t\t\/\/ Up the list count\n\t\t\tvar list = \"${e:\/\/Field\/list}\"\n\t\t\tvar list =\tparseInt(list);\n\t\t\tvar list = list + 1;\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"list\", list);\n\t\t\t\n\t\t\/\/ set var = -1 \n\t\tvar choice_now = -1 ; \n\t\tvar choice_complete = -1;\n\n\t\t$j('.letters').click(function() {\n\t\t\tid = $j(this).attr('name');\n\t\t\tvar time = Date.now() \/ 1000 - time_start;      \n\t\t\tchoice_now = $j(this).attr('id');\n\t\t\ttimes.push(time.toFixed(2));\n\t\t\tchoices.push(choice_now);\n\t\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"Time\", times);\n\t\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"Choices\", choices);\n\t\t\t\n\t\t\tvar id_number = parseInt(id, 10);\n\t\t\t$j(\"td[name='\"+id+\"']\").removeClass(\"letters_selected\").addClass(\"letters\");\n\t\t\t$j(this ).removeClass(\"letters\").addClass(\"letters_selected\");\t\n\t\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"IdFinal\", id_number);\n\t\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"ChoiceFinal\", choice_now);\n\t\t\tif (choice_now.indexOf(\"left\") >= 0) { \n\t\t\t\t\t\tvar norm_lb = (id_number-1)*increment;\n\t\t\t\t\t\tvar norm_ub = (id_number)*increment;\n\t\t\t\t\t\t\n\t\t\t\t\t\tfor (k = id_number ; k > 0; k--) {\n                        x = \"#\" + String(k) + \"left\";\n                        y = \"#\" + String(k) + \"right\";\n                        \/\/ set this checked property to true so we can test for it in completeness check\n                        $j(x).prop(\"checked\", true);\n                        $j( x ).removeClass(\"letters\").addClass(\"letters_selected\");\n                        $j( y ).addClass(\"letters\").removeClass(\"letters_selected\");\n                    }\n\t\t\t\t\t} else {\t\n\t\t\t\t\t\tvar norm_lb = (id_number-2)*increment; \n\t\t\t\t\t\tvar norm_ub = (id_number-1)*increment; \n\t\t\t\t\t\t\n\t\t\t\t\t\tfor (k = id_number ; k < 32; k++) {\n\t\t\t\t\tx = \"#\" + String(k) + \"right\";\n\t\t\t\t\ty = \"#\" + String(k) + \"left\";\n\t\t\t\t\t\/\/ set this checked property to true so we can test for it in completeness check\n\t\t\t\t\t$j(x).prop(\"checked\", true);\n\t\t\t\t\t$j( x ).removeClass(\"letters\").addClass(\"letters_selected\");\n\t\t\t\t\t$j( y ).addClass(\"letters\").removeClass(\"letters_selected\");\n\t\t\t\t}\n\t\t\t\t\t};   \n\t\t\tif (choice_now==\"21left\") { \n\t\t\t\tvar norm_lb = stake;\n\t\t\t\tvar norm_ub = stake;\n\t\t\t\tvar changed_now =1; \n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tif (choice_now==\"1right\") { \n\t\t\t\tvar norm_lb = 0;\n\t\t\t\tvar norm_ub = 0;\n\t\t\t\tvar changed_now =2; \n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tif (norm_lb < increment) { \n\t\t\t\tvar norm_lb = 0;\n\t\t\t\tvar changed_now =3 ;\n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tif (norm_lb > stake) { \n\t\t\t\tvar norm_lb = stake;\n\t\t\t\tvar changed_now =4 ;\n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tif (norm_ub < increment) { \n\t\t\t\tvar norm_ub = 0;\n\t\t\t\tvar changed_now =5 ;\n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tif (norm_ub > stake) { \n\t\t\t\tvar norm_ub = stake;\n\t\t\t\tvar changed_now =6 ;\n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"LB\", norm_lb);\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"UB\", norm_ub);\t\t\t\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"Changed\", changed);\t\t\t\n\t\t\tvar num_rows = 0 ;\n            var checked_rows = 0 ;\n\n            for (k = 1 ; k < 32; k++) {\n\t\t\tnum_rows = num_rows + 1;\n\n                \tx = \"#\" + String(k) + \"right\";\n                \ty = \"#\" + String(k) + \"left\";\n\n\t\t\t\/\/ determine if either the cell on the left or the one on the right is checked; if so, add to the counter\n                \tif ( $j(x).prop(\"checked\") == true || $j( y ).prop(\"checked\") == true) {\n                    \t\tchecked_rows = checked_rows + 1 ;\n                \t}\n                \n\t\t}\n\n\t    \/\/ check if the number of checked rows equals the number of rows\n\t    if (checked_rows == num_rows) {\n\t\t\t    choice_complete = 1 ;\n            }\n            else {\n                choice_complete = -1;\n            }\n\n\t\t});\n\n\t\t$j('table.uncertainty').floatThead({\n\t\t\tuseAbsolutePositioning: false\n\t\t\t\/\/ absolutePositioning is better for\n\t\t\t\/\/ highly dynamic sites\n\t\t\t\/\/ (which this is not)\n\t\t});\n\t\t\t\n\n\t\t\t\/\/ enable submit button when variable no longer -1 \n\t\tthis.questionclick = function(event,element)\n\t\t\t{ \t\t \n\t\t\tif (choice_complete != -1 ) {this.showNextButton();}\n\t\telse   { \tthis.hideNextButton(); }\n\t\t\t}\n\n\t\t\t\/\/ enable submit button when variable no longer -1 \n\t\t\t\/\/this.questionclick = function(event,element)\n\t\t\t\/\/    { \t\t \n\t\t\t\/\/\t if (choice_now != -1 ) {this.enableNextButton(); }\n\t\t\t\/\/  else   { this.disableNextButton();  }\n\t\t\t\t\/\/}\n\t\t\tconsole.log(prefix+\"IdFinal\");\n\t\t});","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID649","SecondaryAttribute":"After you complete the 42 choice tasks and 2 quiz tasks, here is how we will determine your bonus...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"font-size:19px;\"><span style=\"font-style:normal\"><span style=\"font-variant-ligatures:normal\"><span style=\"font-weight:400\"><span style=\"white-space:normal\"><span style=\"background-color:#ffffff\"><span style=\"text-decoration-thickness:initial\"><span style=\"text-decoration-style:initial\"><span style=\"text-decoration-color:initial\">After you complete the 42 choice tasks and 2 quiz tasks, here is how we will determine your bonus payment.<\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/span><br>\n&nbsp;<br>\n<span style=\"text-align: start;\" class=\"im\"><span style=\"font-style:normal\"><span style=\"font-variant-ligatures:normal\"><span style=\"font-weight:400\"><span style=\"white-space:normal\"><span style=\"background-color:#ffffff\"><span style=\"text-decoration-thickness:initial\"><span style=\"text-decoration-style:initial\"><span style=\"text-decoration-color:initial\">First, the computer will randomly select a number between 1 and 5, with each number equally likely. If the number drawn is a 1, then you have been chosen to receive a possible bonus payment.<\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/span><br>\n&nbsp;<br>\n<span style=\"font-style:normal\"><span style=\"font-variant-ligatures:normal\"><span style=\"font-weight:400\"><span style=\"white-space:normal\"><span style=\"background-color:#ffffff\"><span style=\"text-decoration-thickness:initial\"><span style=\"text-decoration-style:initial\"><span style=\"text-decoration-color:initial\">If you are chosen, then the computer will randomly select a number between 1 and 44, with each number equally likely. This determines which task will determine your payment.<\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/span><br>\n<span style=\"font-style:normal\"><span style=\"font-variant-ligatures:normal\"><span style=\"font-weight:400\"><span style=\"white-space:normal\"><span style=\"background-color:#ffffff\"><span style=\"text-decoration-thickness:initial\"><span style=\"text-decoration-style:initial\"><span style=\"text-decoration-color:initial\">&nbsp;<\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/span><br>\n<span style=\"font-style:normal\"><span style=\"font-variant-ligatures:normal\"><span style=\"font-weight:400\"><span style=\"white-space:normal\"><span style=\"background-color:#ffffff\"><span style=\"text-decoration-thickness:initial\"><span style=\"text-decoration-style:initial\"><span style=\"text-decoration-color:initial\">If one of the 2 quiz tasks is selected, then you will receive $5 if your answer to that question is correct.<\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/span><br>\n<span style=\"font-style:normal\"><span style=\"font-variant-ligatures:normal\"><span style=\"font-weight:400\"><span style=\"white-space:normal\"><span style=\"background-color:#ffffff\"><span style=\"text-decoration-thickness:initial\"><span style=\"text-decoration-style:initial\"><span style=\"text-decoration-color:initial\">&nbsp;<\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/span><br>\n<span style=\"font-style:normal\"><span style=\"font-variant-ligatures:normal\"><span style=\"font-weight:400\"><span style=\"white-space:normal\"><span style=\"background-color:#ffffff\"><span style=\"text-decoration-thickness:initial\"><span style=\"text-decoration-style:initial\"><span style=\"text-decoration-color:initial\">If one of the 42 choice tasks is selected, then we will randomly select a decision from that choice task (one of the rows) by drawing&nbsp;<\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/span>another random number, again with each row equally likely. This will be the decision-that-counts. We will determine your payment based on whatever option you chose in the decision-that-counts.<br>\n<br>\n<span style=\"line-height:107%\"><span style=\"line-height:107%\">For example, imagine that you had filled out the decision screen below as indicated, and imagine further that the decision-that-counts turned out to be the fourth row of this decision screen (100% chance of $10 vs. 50% chance of $13, 50% chance of $0).<br>\n<br>\nIn this decision, you chose Option A (100% chance of $10) over Option B (50% chance of $13, 50% chance of $0). In this case, you would receive a $10 bonus payment if you are one of the randomly selected participants who will receive a bonus payment. <\/span><\/span><br>\n<br>\n<span style=\"line-height:107%\"><span style=\"line-height:107%\">If instead you had picked Option B, here's how we would determine your bonus payment. The computer would randomly generate a number between 1 and 100. Each number is equally likely. If the number comes up 1\u201450, we would pay you a $13&nbsp;bonus payment. If the number comes up 51\u2014100, we would pay you a $0 bonus payment.<\/span><\/span><br>\n<br>\n<br>\n<span style=\"line-height:107%\"><b><span style=\"line-height:107%\">Note, these bonus payments are in addition to your $${e:\/\/Field\/showupfee} completion payment.&nbsp;<\/span><\/b><\/span><\/span><\/span><br>\n<br>\n&nbsp;\n<div style=\"text-align: center;\"><br>\n<span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"font-size:19px;\"><img style=\"width: 799px; height: 939px;\" src=\"https:\/\/emotioncaltech.co1.qualtrics.com\/CP\/Graphic.php?IM=IM_3JA5YF4RqL17dwq\"><\/span><\/span><br>\n&nbsp;<\/div>","DefaultChoices":false,"DataExportTag":"Q126","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"After you complete the 42 choice tasks and 2 quiz tasks, here is how we will determine your bonus...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID649","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID650","SecondaryAttribute":"Please answer the following review questions. \u00a0 \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Please answer the following review questions.<\/span><\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>&nbsp;<\/p>","DefaultChoices":false,"DataExportTag":"Q127","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please answer the following review questions. \u00a0 \u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID650","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID687","SecondaryAttribute":"Please click to proceed to the main decisions.","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Please click to proceed to the main decisions.<\/span><\/span>","DefaultChoices":false,"DataExportTag":"Q91","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please click to proceed to the main decisions.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID687","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID729","SecondaryAttribute":"How will we determine your payment from this study?","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">How will we determine your payment from this study?<\/span><\/span>","DataExportTag":