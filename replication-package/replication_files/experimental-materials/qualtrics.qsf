nt=p[current]*100;\n\t\tvar type_current=type[current];\n\t\n\t\tif(current<10){\n\t\t\tvar prefix = \"binary\"+type_current+\"_\"+p_current;\t\n\t\t} else if (current>=10){\n\t\t\tvar prefix = \"binary\"+type_current+\"high_\"+p_current;\t\n\t\t}\n\t\n\n\tvar side = parseInt(eval(\"${e:\/\/Field\/\"+prefix+\"_side}\"));\n\t\t\n\tconsole.log(\"current: \"+current);\n\tconsole.log(\"currentdecision binary: \"+currentdecision_binary);\n\tconsole.log(\"questionnumber: \"+questionnumber);\n\tconsole.log(\"submitprefix:\"+prefix)\n\tconsole.log(\"side:\"+side)\n\t\t\t\n    var choicecaptured= this.getChoiceAnswerValue();\n\n    console.log(\"choice: \"+choicecaptured);\n\t\n\t\n\tQualtrics.SurveyEngine.setEmbeddedData(prefix, choicecaptured);\n\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"_order\", currentdecision_binary);\n});","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"\u00a0 Decision ${e:\/\/Field\/currentdecision} of ${e:\/\/Field\/numdecisions}: Please choose your preferre...","Choices":{"4":{"Display":"Option A"},"5":{"Display":"Option B"}},"ChoiceOrder":["4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"<title><\/title>\n<style type=\"text\/css\">html, body { font-family: arial, sans-serif; }\n    table {}\n    table tr td {\n      text-align: center;\n      padding: 5px;\n    }\n    table th{\n      font-weight: bold;\n      border-bottom: 1px solid black;\n      text-align: center;\n    }\n    tr.noBorder td {\n      border-style: hidden;\n   }\n   .center {\n  margin-left: auto;\n  margin-right: auto;\n}\n<\/style>\n<script src=\"2A-html-string.js\"><\/script>\n<div id=\"container\">&nbsp;<\/div>\n\nDecision ${e:\/\/Field\/currentdecision