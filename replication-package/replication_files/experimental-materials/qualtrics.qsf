  <\/tr>\n <\/tbody>\n<\/table>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\n\t\tvar currentdecision=parseInt(\"${e:\/\/Field\/currentdecision}\");\n\t\tvar currentdecision_binary=parseInt(\"${e:\/\/Field\/currentdecision_binary}\");\n\t\tvar questionnumber=currentdecision_binary.toString();\n\t\n\t\tvar p=\"${e:\/\/Field\/p_binary}\".split(', ');\n\t\tvar r=\"${e:\/\/Field\/r_binary}\".split(', ');\n\t\tvar type=\"${e:\/\/Field\/type_binary}\".split(', ');\n\t\tvar numbers=\"${e:\/\/Field\/order_binary}\".split(',');\n\t\tvar lowoutcome_binary=0;\n\t\tvar highoutcome_binary=\"${e:\/\/Field\/H_binary}\".split(',');\n\t\n\tconsole.log(\"lowbinary:\"+lowoutcome_binary);\n\tconsole.log(\"highbinary:\"+highoutcome_binary);\n\n\t\t\t\t\t\t\t\t\t\n\t\t\tvar current=numbers.indexOf(questionnumber);\n\t\n\t\t\tconsole.log(\"current: \"+current);\n\t\t\tconsole.log(\"currentdecision binary: \"+currentdecision_binary);\n\t\t\tconsole.log(\"questionnumber: \"+questionnumber);\n\t\t\tconsole.log(\"numbers: \" + numbers);\n\t\t\tconsole.log(\"p: \" + p[current]);\n\t\t\tconsole.log(\"r: \" + r[current]);\n\t\n\t\t\tvar p_current=p[current]*100;\n\t\t\tvar r_current=r[current]*100;\n\t\t\tvar type_current=type[current];\n\t\t\tvar low_current=0;\n\t\t\tvar middle_current=p[current]* 30;\n\t\t\tvar high_current=highoutcome_binary[current];\n\t\n\t\t\t\n\t\t\tconsole.log(\"type: \"+type_current);\n\t\t\tconsole.log(\"low:\"+low_current);\n\t\t\tconsole.log(\"mid:\"+middle_current);\n\t\t\tconsole.log(\"high:\"+high_current);\n\t\n\t\/*\n\tMath.floor(Math.random() * (max - min + 1) + min)\n\t\n\t\n\t\t\tif(current<10){\n\t\t\t\tvar prefix = \"binary\"+type_current+\"_\"+p_current;\n\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"_row\", middle_current);\n\t\t\t} else if(current>=10){\n\t\t\t\tvar prefix = \"binary\"+type_current+\"high_\"+p_current;\n\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"_row\", high_current);\n\t\t\t}\n\t\t\t*\/\n\t\n\t\t\n\t\t\tif(type_current==\"AC\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=p_current;\n\t\t\t\tvar right_low=100-p_current;\n\t\t\t} else if(type_current==\"ACrepeat\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=p_current;\n\t\t\t\tvar right_low=100-p_current;\n\t\t\t} else if(type_current==\"AB1\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_middle=100-r_current;\n\t\t\t\tvar right_low=(r_current*(100-p_current))\/100;\n\t\t\t} else if(type_current==\"AB2\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_middle=100-r_current;\n\t\t\t\tvar right_low=(r_current*(100-p_current))\/100;\n\t\t\t} else if(type_current==\"AB1repeat\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_middle=100-r_current;\n\t\t\t\tvar right_low=(r_current*(100-p_current))\/100;\n\t\t\t} else if(type_current==\"AB2repeat\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_middle=100-r_current;\n\t\t\t\tvar right_low=(r_current*(100-p_current))\/100;\n\t\t\t}else if(type_current==\"D1E1\"){\n\t\t\t\tvar left_middle=r_current;\n\t\t\t\tvar left_low=100-r_current;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_low=100-(r_current*p_current)\/100;\n\t\t\t} else if(type_current==\"D2E2\"){\n\t\t\t\tvar left_middle=r_current;\n\t\t\t\tvar left_low=100-r_current;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_low=100-(r_current*p_current)\/100;\n\t\t\t} else if(type_current==\"D1E1repeat\"){\n\t\t\t\tvar left_middle=r_current;\n\t\t\t\tvar left_low=100-r_current;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_low=100-(r_current*p_current)\/100;\n\t\t\t} else if(type_current==\"D2E2repeat\"){\n\t\t\t\tvar left_middle=r_current;\n\t\t\t\tvar left_low=100-r_current;\n\t\t\t\tvar right_high=