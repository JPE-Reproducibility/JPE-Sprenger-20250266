lementById(\"rightpos1\").innerHTML = rightpos1; \n\t\t\tdocument.getElementById(\"rightpos2\").innerHTML = rightpos2; \n\t\t\tdocument.getElementById(\"rightpos3\").innerHTML = rightpos3; \n\t\t}\n\t\tif(type_current==\"D2E2\"){\n\t\t\tvar rightpos1=right_low + \"% chance of $\"+low_current;\n\t\t\tvar rightpos2=right_high + \"% chance of $\"+high_current;\n\t\t\tvar rightpos3=\"\";\n\t\t\tvar leftpos1=left_low + \"% chance of $\"+low_current;\n\t\t\tvar leftpos2=left_middle + \"% chance of $\"+middle_current;\n\t\t\tvar leftpos3=\"\";\n\t\t\tdocument.getElementById(\"leftpos1\").innerHTML = leftpos1; \n\t\t\tdocument.getElementById(\"leftpos2\").innerHTML = leftpos2; \n\t\t\tdocument.getElementById(\"leftpos3\").innerHTML = leftpos3;\n\t\t\tdocument.getElementById(\"rightpos1\").innerHTML = rightpos1; \n\t\t\tdocument.getElementById(\"rightpos2\").innerHTML = rightpos2; \n\t\t\tdocument.getElementById(\"rightpos3\").innerHTML = rightpos3; \n\t\t}\n\t}\n\t\n});\nQualtrics.SurveyEngine.addOnPageSubmit(function() \n{\n\t\t\n\t\tvar currentdecision=parseInt(\"${e:\/\/Field\/currentdecision}\");\n\t\tvar currentdecision_binary=parseInt(\"${e:\/\/Field\/currentdecision_binary}\");\n\t\tvar questionnumber=currentdecision_binary.toString();\n\t\n\t\tvar p=\"${e:\/\/Field\/p_binary}\".split(', ');\n\t\tvar r=\"${e:\/\/Field\/r_binary}\".split(', ');\n\t\tvar type=\"${e:\/\/Field\/type_binary}\".split(', ');\n\t\tvar numbers=\"${e:\/\/Field\/order_binary}\".split(',');\n\n\t\t\t\t\t\t\t\t\n\t\tvar current=numbers.indexOf(questionnumber);\n\t\tvar p_current=p[current]*100;\n\t\tvar type_current=type[current];\n\t\n\t\t\n\tconsole.log(\"currentdecision: \", currentdecision);\n\n\t\n\t\t\n\tconsole.log(\"current: \"+current);\n\tconsole.log(\"currentdecision binary: \"+currentdecision_binary);\n\tconsole.log(\"questionnumber: \"+questionnumber);\n\t\t\t\n    var choicecaptured= this.getChoiceAnswerValue();\n\n    console.log(\"choice: \"+choicecaptured);\n\t\n\t\n\tQualtrics.S