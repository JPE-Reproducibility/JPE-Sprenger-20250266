etica,sans-serif;\">(Note that you cannot click on the submit button until you have selected an answer.<span style=\"font-weight: bolder;\">&nbsp;<\/span>In order to progress, your choices must &quot;switch&quot; from Option A to Option B, like shown below. You will have to click once on Option A and once on Option B, in the subsequent row, to proceed. You can also click Option A in all rows, or Option B in all rows.)<\/span><\/span><\/span><\/div>\n<\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n\t\t{\n\t\t\t\/*Place your JavaScript here to run when the page loads*\/\n\n\n\t\t\/\/ disable submit button\n\t\tthis.hideNextButton();\n\n\t\t\/\/\t this.disableNextButton();\n\n\t\t\tvar loop = parseInt(\"${lm:\/\/CurrentLoopNumber}\");\n\t\t\t\/\/$j(\".QuestionText\").remove();\n\t\t\tvar inputId = \"#\" + String(this.questionId);\n\n\t\t\/\/ Using Piped Text to get embedded data fields\n\t\n\t\t\tvar currentdecision=parseInt(\"${e:\/\/Field\/currentdecision}\");\n\t\t\tvar questionnumber=currentdecision.toString();\n\t\n\t\t\tvar p=\"${e:\/\/Field\/p}\".split(', ');\n\t\t\tvar r=\"${e:\/\/Field\/r}\".split(', ');\n\t\t\tvar type=\"${e:\/\/Field\/type}\".split(', ');\n\t\t\tvar numbers=\"${e:\/\/Field\/numbers}\".split(',');\n\t\t\tvar order=\"${e:\/\/Field\/order}\".split(', ');\n\t\n\t\t\tvar increment=1;\n\t\n\t\n\t\t\tconsole.log(p);\n\t\t\tconsole.log(r);\n\t\t\tconsole.log(type);\n\t\t\tconsole.log(numbers);\n\t\t\tconsole.log(order);\n\t\t\tconsole.log(currentdecision);\n\t\t\tconsole.log(questionnumber);\n\t\n\t\n\t\t\t\n\t\t\t\t\t\t\n\t\t\tvar current=order.indexOf(questionnumber);\n\t\n\t\t\tconsole.log(current);\n\t\n\t\t\tvar p_current=p[current]*100;\n\t\t\tvar r_current=r[current]*100;\n\t\t\tvar type_current=type[current];\n\t\n\t\t\tconsole.log(p_current);\n\t\t\tconsole.log(r_current);\n\t\t\tconsole.log(type_current);\n\t\n\t\n\t\t\tif(type_current==\"D1F\"){\n\t\t\t\tvar rF=r[current].split(';');\n\t\t\t\tvar r1=rF[0];\n\t\t\t\tvar r2=rF[1];\n\t\t\t\tconsole.log(r1);\n\t\t\t\tconsole.log(r2);\n\t\t\t\t}\n\t\n\t\t\t\n\t\t\tif(type_current==\"AC\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=p_current;\n\t\t\t\tvar right_low=100-p_current;\n\t\t\t} else if(type_current==\"ACrepeat\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=p_current;\n\t\t\t\tvar right_low=100-p_current;\n\t\t\t} else if(type_current==\"AB1\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_middle=100-r_current;\n\t\t\t\tvar right_low=(r_current*(100-p_current))\/100;\n\t\t\t} else if(type_current==\"AB2\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_middle=100-r_current;\n\t\t\t\tvar right_low=(r_current*(100-p_current))\/100;\n\t\t\t} else if(type_current==\"AB1repeat\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_middle=100-r_current;\n\t\t\t\tvar right_low=(r_current*(100-p_current))\/100;\n\t\t\t} else if(type_current==\"AB2repeat\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_middle=100-r_current;\n\t\t\t\tvar right_low=(r_current*(100-p_current))\/100;\n\t\t\t}else if(type_current==\"D1E1\"){\n\t\t\t\tvar left_middle=r_current;\n\t\t\t\tvar left_low=100-r_current;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_low=100-(r_current*p_current)\/100;\n\t\t\t} else if(type_current==\"D2E2\"){\n\t\t\t\tvar left_middle=r_current;\n\t\t\t\tvar left_low=100-r_current;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_low=100-(r_current*p_current)\/100;\n\t\t\t} else if(type_current==\"D1E1repeat\"){\n\t\t\t\tvar left_middle=r_current;\n\t\t\t\tvar left_low=100-r_current;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_low=100-(r_current*p_current)\/100;\n\t\t\t} else if(type_current==\"D2E2repeat\"){\n\t\t\t\tvar left_middle=r_current;\n\t\t\t\tvar left_low=100-r_current;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_low=100-(r_current*p_current)\/100;\n\t\t\t} else if(type_current==\"D1F\"){\n\t\t\t\tvar left_middle=r1*100;\n\t\t\t\tvar left_low=100-r1*100;\n\t\t\t\tvar right_high=(r2*100*p_current)\/100;\n\t\t\t\tvar right_middle=r1*100 - r2*100;\n\t\t\t\tvar right_low=100-r1*100 +(r2*100*(100-p_current))\/100;\n\t\t\t}\n\t\t\t\n\t\n\t\n\t\t\t\n\t\n\t\tvar lowoutcome=parseInt(\"${e:\/\/Field\/lowoutcome}\");\n\t\tvar middleoutcome=(p_current\/100)*30;\n\t\tvar stake=middleoutcome+40;\n\t\n\t\t\t\n\t\t\tvar optionAunits = \" tasks\";\n\t\t\tvar optionBunits = \" tasks\";\n\t\t\tvar optionAtext = \"100% chance of \";\n\t\t\tvar optionAvalue = \"$\";\n\t\t\tvar percentchanceof = \"% chance of \";\n\t\t\tvar comma = \",\";\n\t\t\tvar dollar = \"$\";\n\t\t\tvar dollarbold=dollar.bold();\n\t\t\t\n\t\t\t\n\t\t\tvar prefix=type_current;\n\t\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"_order\", currentdecision);\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"currentdecision\", currentdecision+1);\n\t\t\/\/ ============================================================================\n\t\t\/\/ TABLE COLUMN HEADERS \n\t\t\t$j(inputId).append(\"<table  align='center' class='uncertainty'>\\\n\t\t<thead class='uncertaintyhead'>\\\n\t\t<tr>\\\n\t\t<th style='width:12em' class='thtext'> Option A:  <\/th>\\\n\t\t\t<th style='width:1em'><\/th>\\\n\t\t<th style='width:12em' class='thtext'> Option B:  <\/th>\\\n\t\t<\/tr>\\\n\t\t<\/thead>\\\n\t\t<tbody class='uncert' id='maintable'>\\\n\t\t<tr class='middletd'>\\\n\t\t\t<td><\/td>\\\n\t\t\t<td><\/td>\\\n\t\t\t<td><\/td>\\\n\t\t<\/tr>\\\n\t\t<\/tbody>\\\n\t\t<\/table>\")\n\t\t\/\/ ============================================================================\n\t\t\/\/ TABLE ROWS \n\t\tmultistring = \"\";\n\t\tincrement = 1;\n\tfor (i = middleoutcome; i <= middleoutcome+40; i++) {\n\t\t\tvar num = i*increment;\n\t\t\tvar n = num.toFixed(0);\n\t\t\tvar nbold=n.bold();\n\t\t\t\/\/multistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ optionAtext + \" \" + dollar + p_current + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ p2 + optionBtext + \" \" + dollarbold + nbold + comma + \"<\/br>\" +  p1 + optionBtext + \" \" + dollar + x3  +\"<\/td><\/tr>\";}\t\t\/\/ SAVE OUTPUT \n\t\t\n\t\n\t\tif(type_current==\"AC\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} else if(type_current==\"ACrepeat\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} else if(type_current==\"AB1\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_middle + percentchanceof + dollar + middleoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} else if(type_current==\"AB2\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_middle + percentchanceof + dollar + middleoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} else if(type_current==\"AB1repeat\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_middle + percentchanceof + dollar + middleoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} else if(type_current==\"AB2repeat\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_middle + percentchanceof + dollar + middleoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} else if(type_current==\"D1E1\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_low + percentchanceof+ dollar + lowoutcome + \"<\/br>\" + left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} else if(type_current==\"D2E2\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_low + percentchanceof+ dollar + lowoutcome + \"<\/br>\" + left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} else if(type_current==\"D1E1repeat\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_low + percentchanceof+ dollar + lowoutcome + \"<\/br>\" + left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} else if(type_current==\"D2E2repeat\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_low + percentchanceof+ dollar + lowoutcome + \"<\/br>\" + left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} else if(type_current==\"D1F\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_low + percentchanceof+ dollar + lowoutcome + \"<\/br>\" + left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_middle + percentchanceof + dollar + middleoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} \n\t\t}\n\t\t\t\t\t \n\t\t\t\n\t\t\t\n\t\t$j('#maintable').append(multistring)\n\t\t\t\t\t\n\t\t\n\n\t\t\tvar choiceThatCounts = -1;\n\t\t\/\/save the data\n\t\t\tvar time_start = Date.now() \/ 1000;\n\t\t\tvar times = [];\n\t\t\tvar choices = [];\n\t\t\tvar changed=[];\n\t\t\/\/ Up the list count\n\t\t\tvar list = \"${e:\/\/Field\/list}\"\n\t\t\tvar list =\tparseInt(list);\n\t\t\tvar list = list + 1;\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"list\", list);\n\t\t\t\n\t\t\/\/ set var = -1 \n\t\tvar choice_now = -1 ; \n\t\tvar choice_complete = -1;\n\n\t\t$j('.letters').click(function() {\n\t\t\tid = $j(this).attr('name');\n\t\t\tvar time = Date.now() \/ 1000 - time_start;      \n\t\t\tchoice_now = $j(this).attr('id');\n\t\t\ttimes.push(time.toFixed(2));\n\t\t\tchoices.push(choice_now);\n\t\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"Time\", times);\n\t\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"Choices\", choices);\n\t\t\t\n\t\t\tvar id_number = parseInt(id, 10);\n\t\t\tconsole.log(id_number);\n\t\t\t$j(\"td[name='\"+id+\"']\").removeClass(\"letters_selected\").addClass(\"letters\");\n\t\t\t$j(this ).removeClass(\"letters\").addClass(\"letters_selected\");\t\n\t\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"IdFinal\", id_number);\n\t\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"ChoiceFinal\", choice_now);\n\t\t\tif (choice_now.indexOf(\"left\") >= 0) { \n\t\t\t\t\t\tvar norm_lb = (id_number-1)*increment;\n\t\t\t\t\t\tvar norm_ub = (id_number)*increment;\n\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\tfor (k = id_number ; k > middleoutcome; k--) {\n                        x = \"#\" + String(k) + \"left\";\n                        y = \"#\" + String(k) + \"right\";\n                        \/\/ set this checked property to true so we can test for it in completeness check\n                        $j(x).prop(\"checked\", true);\n                        $j( x ).removeClass(\"letters\").addClass(\"letters_selected\");\n                        $j( y ).addClass(\"letters\").removeClass(\"letters_selected\");\n                    }\n\t\t\t\t\t} else {\t\n\t\t\t\t\t\tvar norm_lb = (id_number-2)*increment; \n\t\t\t\t\t\tvar norm_ub = (id_number-1)*increment; \n\t\t\t\t\t\t\n\t\t\t\t\t\tfor (k = id_number ; k < middleoutcome+42; k++) {\n\t\t\t\t\tx = \"#\" + String(k) + \"right\";\n\t\t\t\t\ty = \"#\" + String(k) + \"left\";\n\t\t\t\t\t\/\/ set this checked property to true so we can test for it in completeness check\n\t\t\t\t\t$j(x).prop(\"checked\", true);\n\t\t\t\t\t$j( x ).removeClass(\"letters\").addClass(\"letters_selected\");\n\t\t\t\t\t$j( y ).addClass(\"letters\").removeClass(\"letters_selected\");\n\t\t\t\t}\n\t\t\t\t\t};   \n\t\t\tif (choice_now==\"21left\") { \n\t\t\t\tvar norm_lb = stake;\n\t\t\t\tvar norm_ub = stake;\n\t\t\t\tvar changed_now =1; \n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tif (choice_now==\"1right\") { \n\t\t\t\tvar norm_lb = 0;\n\t\t\t\tvar norm_ub = 0;\n\t\t\t\tvar changed_now =2; \n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tif (norm_lb < increment) { \n\t\t\t\tvar norm_lb = 0;\n\t\t\t\tvar changed_now =3 ;\n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tif (norm_lb > stake) { \n\t\t\t\tvar norm_lb = stake;\n\t\t\t\tvar changed_now =4 ;\n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tif (norm_ub < increment) { \n\t\t\t\tvar norm_ub = 0;\n\t\t\t\tvar changed_now =5 ;\n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tif (norm_ub > stake) { \n\t\t\t\tvar norm_ub = stake;\n\t\t\t\tvar changed_now =6 ;\n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"LB\", norm_lb);\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"UB\", norm_ub);\t\t\t\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"Changed\", changed);\t\t\t\n\t\t\tvar num_rows = 0 ;\n            var checked_rows = 0 ;\n\n            for (k = middleoutcome+1 ; k < middleoutcome+42; k++) {\n\t\t\tnum_rows = num_rows + 1;\n\n                \tx = \"#\" + String(k) + \"right\";\n                \ty = \"#\" + String(k) + \"left\";\n\n\t\t\t\/\/ determine if either the cell on the left or the one on the right is checked; if so, add to the counter\n                \tif ( $j(x).prop(\"checked\") == true || $j( y ).prop(\"checked\") == true) {\n                    \t\tchecked_rows = checked_rows + 1 ;\n                \t}\n                \n\t\t}\n\n\t    \/\/ check if the number of checked rows equals the number of rows\n\t    if (checked_rows == num_rows) {\n\t\t\t    choice_complete = 1 ;\n            }\n            else {\n                choice_complete = -1;\n            }\n\n\t\t});\n\n\t\t$j('table.uncertainty').floatThead({\n\t\t\tuseAbsolutePositioning: false\n\t\t\t\/\/ absolutePositioning is better for\n\t\t\t\/\/ highly dynamic sites\n\t\t\t\/\/ (which this is not)\n\t\t});\n\t\t\t\n\n\t\t\t\/\/ enable submit button when variable no longer -1 \n\t\tthis.questionclick = function(event,element)\n\t\t\t{ \t\t \n\t\t\tif (choice_complete != -1 ) {this.showNextButton();}\n\t\telse   { \tthis.hideNextButton(); }\n\t\t\t}\n\n\t\t\t\/\/ enable submit button when variable no longer -1 \n\t\t\t\/\/this.questionclick = function(event,element)\n\t\t\t\/\/    { \t\t \n\t\t\t\/\/\t if (choice_now != -1 ) {this.enableNextButton(); }\n\t\t\t\/\/  else   { this.disableNextButton();  }\n\t\t\t\t\/\/}\n\t\t\tconsole.log(prefix+\"IdFinal\");\n\t\t\t\t\t \n\t\t\t\n\t\t});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Decision ${e:\/\/Field\/currentdecision} of ${e:\/\/Field\/numdecisions}: Please complete the decision...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"<div><span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Decision ${e:\/\/Field\/currentdecision} of ${e:\/\/Field\/numdecisions}: Please complete the decision problem below.<br \/>\n<br \/>\n<span style=\"color:#bdc3c7;\">Reminder: Please indicate which option you prefer on each row by clicking on the row where you would like to switch from choosing the option on the left to choosing the option on the right.<\/span><\/span><\/span><\/div>\n\n<div>&nbsp;<\/div>\n\n<div>\n<div><span style=\"color:#bdc3c7;\"><span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">(Note that you cannot click on the submit button until you have selected an answer.<span style=\"font-weight: bolder;\">&nbsp;<\/span>In order to progress, your choices must &quot;switch&quot; from Option A to Option B, like shown below. You will have to click once on Option A and once on Option B, in the subsequent row, to proceed. You can also click Option A in all rows, or Option B in all rows.)<\/span><\/span><\/span><\/div>\n<\/div>","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1,"DataExportTag":"Q1328","QuestionID":"QID1328"}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID1329","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionText_Unsafe":"Timing","DataExportTag":"Q1329","QuestionID":"QID1329"}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID1330","SecondaryAttribute":"Please click to proceed.","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Please click to proceed.<\/span><\/span>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\n\t\/*var currentdecision = parseInt(\"${e:\/\/Field\/currentdecision}\");\n\tvar nextdecision=currentdecision+1;\n\t\n\t\n\tQualtrics.SurveyEngine.setEmbeddedData(\"currentdecision\", nextdecision);\n\tQualtrics.SurveyEngine.setEmbeddedData(\"group1_ac_order\", currentdecision);\n*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please click to proceed.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"<span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Please click to proceed.<\/span><\/span>","DataExportTag":"Q1330","QuestionID":"QID1330"}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID1331","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":0,"MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"#QuestionText, TimingPageSubmit#"},"4":{"Display":"#QuestionText, TimingClickCount#"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"Q1331","QuestionID":"QID1331"}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID1332","SecondaryAttribute":"Decision ${e:\/\/Field\/currentdecision} of ${e:\/\/Field\/numdecisions}: Please complete the decision...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Decision ${e:\/\/Field\/currentdecision} of ${e:\/\/Field\/numdecisions}: Please complete the decision problem below.<br \/>\n<br \/>\n<span style=\"color:#bdc3c7;\">Reminder: Please indicate which option you prefer on each row by clicking on the row where you would like to switch from choosing the option on the left to choosing the option on the right.<\/span><\/span><\/span><\/div>\n\n<div>&nbsp;<\/div>\n\n<div>\n<div><span style=\"color:#bdc3c7;\"><span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">(Note that you cannot click on the submit button until you have selected an answer.<span style=\"font-weight: bolder;\">&nbsp;<\/span>In order to progress, your choices must &quot;switch&quot; from Option A to Option B, like shown below. You will have to click once on Option A and once on Option B, in the subsequent row, to proceed. You can also click Option A in all rows, or Option B in all rows.)<\/span><\/span><\/span><\/div>\n<\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n\t\t{\n\t\t\t\/*Place your JavaScript here to run when the page loads*\/\n\n\n\t\t\/\/ disable submit button\n\t\tthis.hideNextButton();\n\n\t\t\/\/\t this.disableNextButton();\n\n\t\t\tvar loop = parseInt(\"${lm:\/\/CurrentLoopNumber}\");\n\t\t\t\/\/$j(\".QuestionText\").remove();\n\t\t\tvar inputId = \"#\" + String(this.questionId);\n\n\t\t\/\/ Using Piped Text to get embedded data fields\n\t\n\t\t\tvar currentdecision=parseInt(\"${e:\/\/Field\/currentdecision}\");\n\t\t\tvar questionnumber=currentdecision.toString();\n\t\n\t\t\tvar p=\"${e:\/\/Field\/p}\".split(', ');\n\t\t\tvar r=\"${e:\/\/Field\/r}\".split(', ');\n\t\t\tvar type=\"${e:\/\/Field\/type}\".split(', ');\n\t\t\tvar numbers=\"${e:\/\/Field\/numbers}\".split(',');\n\t\t\tvar order=\"${e:\/\/Field\/order}\".split(', ');\n\t\n\t\t\tvar increment=1;\n\t\n\t\n\t\t\tconsole.log(p);\n\t\t\tconsole.log(r);\n\t\t\tconsole.log(type);\n\t\t\tconsole.log(numbers);\n\t\t\tconsole.log(order);\n\t\t\tconsole.log(currentdecision);\n\t\t\tconsole.log(questionnumber);\n\t\n\t\n\t\t\t\n\t\t\t\t\t\t\n\t\t\tvar current=order.indexOf(questionnumber);\n\t\n\t\t\tconsole.log(current);\n\t\n\t\t\tvar p_current=p[current]*100;\n\t\t\tvar r_current=r[current]*100;\n\t\t\tvar type_current=type[current];\n\t\n\t\t\tconsole.log(p_current);\n\t\t\tconsole.log(r_current);\n\t\t\tconsole.log(type_current);\n\t\n\t\n\t\t\tif(type_current==\"D1F\"){\n\t\t\t\tvar rF=r[current].split(';');\n\t\t\t\tvar r1=rF[0];\n\t\t\t\tvar r2=rF[1];\n\t\t\t\tconsole.log(r1);\n\t\t\t\tconsole.log(r2);\n\t\t\t\t}\n\t\n\t\t\t\n\t\t\tif(type_current==\"AC\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=p_current;\n\t\t\t\tvar right_low=100-p_current;\n\t\t\t} else if(type_current==\"ACrepeat\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=p_current;\n\t\t\t\tvar right_low=100-p_current;\n\t\t\t} else if(type_current==\"AB1\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_middle=100-r_current;\n\t\t\t\tvar right_low=(r_current*(100-p_current))\/100;\n\t\t\t} else if(type_current==\"AB2\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_middle=100-r_current;\n\t\t\t\tvar right_low=(r_current*(100-p_current))\/100;\n\t\t\t} else if(type_current==\"AB1repeat\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_middle=100-r_current;\n\t\t\t\tvar right_low=(r_current*(100-p_current))\/100;\n\t\t\t} else if(type_current==\"AB2repeat\"){\n\t\t\t\tvar left_middle=100;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_middle=100-r_current;\n\t\t\t\tvar right_low=(r_current*(100-p_current))\/100;\n\t\t\t}else if(type_current==\"D1E1\"){\n\t\t\t\tvar left_middle=r_current;\n\t\t\t\tvar left_low=100-r_current;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_low=100-(r_current*p_current)\/100;\n\t\t\t} else if(type_current==\"D2E2\"){\n\t\t\t\tvar left_middle=r_current;\n\t\t\t\tvar left_low=100-r_current;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_low=100-(r_current*p_current)\/100;\n\t\t\t} else if(type_current==\"D1E1repeat\"){\n\t\t\t\tvar left_middle=r_current;\n\t\t\t\tvar left_low=100-r_current;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_low=100-(r_current*p_current)\/100;\n\t\t\t} else if(type_current==\"D2E2repeat\"){\n\t\t\t\tvar left_middle=r_current;\n\t\t\t\tvar left_low=100-r_current;\n\t\t\t\tvar right_high=(r_current*p_current)\/100;\n\t\t\t\tvar right_low=100-(r_current*p_current)\/100;\n\t\t\t} else if(type_current==\"D1F\"){\n\t\t\t\tvar left_middle=r1*100;\n\t\t\t\tvar left_low=100-r1*100;\n\t\t\t\tvar right_high=(r2*100*p_current)\/100;\n\t\t\t\tvar right_middle=r1*100 - r2*100;\n\t\t\t\tvar right_low=100-r1*100 +(r2*100*(100-p_current))\/100;\n\t\t\t}\n\t\t\t\n\t\n\t\n\t\t\t\n\t\n\t\tvar lowoutcome=parseInt(\"${e:\/\/Field\/lowoutcome}\");\n\t\tvar middleoutcome=(p_current\/100)*30;\n\t\tvar stake=middleoutcome+40;\n\t\n\t\t\t\n\t\t\tvar optionAunits = \" tasks\";\n\t\t\tvar optionBunits = \" tasks\";\n\t\t\tvar optionAtext = \"100% chance of \";\n\t\t\tvar optionAvalue = \"$\";\n\t\t\tvar percentchanceof = \"% chance of \";\n\t\t\tvar comma = \",\";\n\t\t\tvar dollar = \"$\";\n\t\t\tvar dollarbold=dollar.bold();\n\t\t\t\n\t\t\t\n\t\t\tvar prefix=type_current;\n\t\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"_order\", currentdecision);\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"currentdecision\", currentdecision+1);\n\t\t\/\/ ============================================================================\n\t\t\/\/ TABLE COLUMN HEADERS \n\t\t\t$j(inputId).append(\"<table  align='center' class='uncertainty'>\\\n\t\t<thead class='uncertaintyhead'>\\\n\t\t<tr>\\\n\t\t<th style='width:12em' class='thtext'> Option A:  <\/th>\\\n\t\t\t<th style='width:1em'><\/th>\\\n\t\t<th style='width:12em' class='thtext'> Option B:  <\/th>\\\n\t\t<\/tr>\\\n\t\t<\/thead>\\\n\t\t<tbody class='uncert' id='maintable'>\\\n\t\t<tr class='middletd'>\\\n\t\t\t<td><\/td>\\\n\t\t\t<td><\/td>\\\n\t\t\t<td><\/td>\\\n\t\t<\/tr>\\\n\t\t<\/tbody>\\\n\t\t<\/table>\")\n\t\t\/\/ ============================================================================\n\t\t\/\/ TABLE ROWS \n\t\tmultistring = \"\";\n\t\tincrement = 1;\n\tfor (i = middleoutcome; i <= middleoutcome+40; i++) {\n\t\t\tvar num = i*increment;\n\t\t\tvar n = num.toFixed(0);\n\t\t\tvar nbold=n.bold();\n\t\t\t\/\/multistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ optionAtext + \" \" + dollar + p_current + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ p2 + optionBtext + \" \" + dollarbold + nbold + comma + \"<\/br>\" +  p1 + optionBtext + \" \" + dollar + x3  +\"<\/td><\/tr>\";}\t\t\/\/ SAVE OUTPUT \n\t\t\n\t\n\t\tif(type_current==\"AC\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} else if(type_current==\"ACrepeat\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} else if(type_current==\"AB1\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_middle + percentchanceof + dollar + middleoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} else if(type_current==\"AB2\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='wid