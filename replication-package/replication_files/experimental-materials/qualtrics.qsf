orm_lb = (id_number-2)*increment; \n\t\t\t\t\t\tvar norm_ub = (id_number-1)*increment; \n\t\t\t\t\t\t\n\t\t\t\t\t\tfor (k = id_number ; k < middleoutcome+42; k++) {\n\t\t\t\t\tx = \"#\" + String(k) + \"right\";\n\t\t\t\t\ty = \"#\" + String(k) + \"left\";\n\t\t\t\t\t\/\/ set this checked property to true so we can test for it in completeness check\n\t\t\t\t\t$j(x).prop(\"checked\", true);\n\t\t\t\t\t$j( x ).removeClass(\"letters\").addClass(\"letters_selected\");\n\t\t\t\t\t$j( y ).addClass(\"letters\").removeClass(\"letters_selected\");\n\t\t\t\t}\n\t\t\t\t\t};   \n\t\t\tif (choice_now==\"21left\") { \n\t\t\t\tvar norm_lb = stake;\n\t\t\t\tvar norm_ub = stake;\n\t\t\t\tvar changed_now =1; \n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tif (choice_now==\"1right\") { \n\t\t\t\tvar norm_lb = 0;\n\t\t\t\tvar norm_ub = 0;\n\t\t\t\tvar changed_now =2; \n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tif (norm_lb < increment) { \n\t\t\t\tvar norm_lb = 0;\n\t\t\t\tvar changed_now =3 ;\n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tif (norm_lb > stake) { \n\t\t\t\tvar norm_lb = stake;\n\t\t\t\tvar changed_now =4 ;\n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tif (norm_ub < increment) { \n\t\t\t\tvar norm_ub = 0;\n\t\t\t\tvar changed_now =5 ;\n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tif (norm_ub > stake) { \n\t\t\t\tvar norm_ub = stake;\n\t\t\t\tvar changed_now =6 ;\n\t\t\t\tchanged.push(changed_now);\n\t\t\t};\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"LB\", norm_lb);\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"UB\", norm_ub);\t\t\t\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"Changed\", changed);\t\t\t\n\t\t\tvar num_rows = 0 ;\n            var checked_rows = 0 ;\n\n            for (k = middleoutcome+1 ; k < middleoutcome+42; k++) {\n\t\t\tnum_rows = num_rows + 1;\n\n                \tx = \"#\" + String(k) + \"right\";\n                \ty = \"#\" + String(k) + \"left\";\n\n\t\t\t\/\/ determine if either the cell on the left or the one on the right is checked; if so, add to the counter\n                \tif ( $j(x).prop(\"checked\") == true || $j( y ).prop(\"checked\") == true) {\n                    \t\tchecked_rows = checked_rows + 1 ;\n                \t}\n                \n\t\t}\n\n\t    \/\/ check if the number of checked rows equals the number of rows\n\t    if (checked_rows == num_rows) {\n\t\t\t    choice_complete = 1 ;\n            }\n            else {\n                choice_complete = -1;\n            }\n\n\t\t});\n\n\t\t$j('table.uncertainty').floatThead({\n\t\t\tuseAbsolutePositioning: false\n\t\t\t\/\/ absolutePositioning is better for\n\t\t\t\/\/ highly dynamic sites\n\t\t\t\/\/ (which this is not)\n\t\t});\n\t\t\t\n\n\t\t\t\/\/ enable submit button when variable no longer -1 \n\t\tthis.questionclick = function(event,element)\n\t\t\t{ \t\t \n\t\t\tif (choice_complete != -1 ) {this.showNextButton();}\n\t\telse   { \tthis.hideNextButton(); }\n\t\t\t}\n\n\t\t\t\/\/ enable submit button when variable no longer -1 \n\t\t\t\/\/this.questionclick = function(event,element)\n\t\t\t\/\/    { \t\t \n\t\t\t\/\/\t if (choice_now != -1 ) {this.enableNextButton(); }\n\t\t\t\/\/  else   { this.disableNextButton();  }\n\t\t\t\t\/\/}\n\t\t\tconsole.log(prefix+currentdecision+\"IdFinal\");\n\t\t\t\t\t \n\t\t\t\n\t\t});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Decision ${e:\/\/Field\/currentdecision} of ${e:\/\/Field\/numdecisions_mpl}: Please complete the decis...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"<div><span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Decision ${e:\/\/Field\/currentdecision} of ${e:\/\/Field\/numdecisions}: Please complete the decision problem below.<br \/>\n<br \/>\n<span style=\"color:#bdc3c7;\">Reminder: Please indicate which option you prefer on each row by clicking on the row where you would like to switch from choosing the option on the left to choosing the option on the right.<\/span><\/span><\/span><\/div>\n\n<div>&nbsp;<\/div>\n\n<div>\n<div><span style=\"color:#bdc3c7;\"><span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">(Note that you cannot click on the submit button until you have selected an answer.<span style=\"font-weight: bolder;\">&nbsp;<\/span>In order to progress, your choices must &quot;switch&quot; from Option A to Option B, like shown below. You will have to click once on Option A and once on Option B, in the subsequent row, to proceed. You can also click Option A in all rows, or Option B in all rows.)<\/span><\/span><\/span><\/div>\n<\/div>","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1,"DataExportTag":"Q1288","QuestionID":"QID1288"}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID1289","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionText_Unsafe":"Timing","DataExportTag":"Q1289","QuestionID":"QID1289"}},{"SurveyID":"SV_eIZIbt2I8fkVkOy","Element":"SQ","PrimaryAttribute":"QID1290","SecondaryAttribute":"Please click to proceed.","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:19px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Please click to proceed.<\/span><\/span>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\n\t\/*var currentdecision = parseInt(\"${e:\/\/Field\/currentdecision}\");\n\tvar nex