t + \" \" + dollarbold + nbold + comma + \"<\/br>\" +  p1 + optionBtext + \" \" + dollar + x3  +\"<\/td><\/tr>\";}\t\t\/\/ SAVE OUTPUT \n\t\t\n\t\n\t\tif(type_current==\"AC\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} else if(type_current==\"ACrepeat\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_high + percentchanceof + dollarbold + nbold +\"<\/td><\/tr>\";\n\t\t\t} else if(type_current==\"AB1\"){\n\t\t\tmultistring = multistring + \"\\<tr class='middletd'> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\"+ left_middle + percentchanceof + dollar + middleoutcome + \"<\/td> <td style='width:5em'>OR<\/td> <td style='width:15em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\"+ right_low + percentchanceof + dollar + lowoutcome + \"<\/br>\" + right_middle + percentc